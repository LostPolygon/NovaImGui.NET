<Project>
    <!-- T4 templates generation -->
    <ItemGroup>
        <TextTemplate Include="**\*.tt" />
        <Generated Include="**\*.gen.cs" />
    </ItemGroup>

    <!-- https://github.com/dotnet/msbuild/issues/5570 -->
    <Target Name="TextTemplateTransform"
            BeforeTargets="BeforeBuild"
            Inputs="@(TextTemplate)"
            Outputs="@(TextTemplate->'%(RecursiveDir)Generated\%(Filename).gen.cs')">
        <Exec WorkingDirectory="$(ProjectDir)" Command="dotnet t4 %(TextTemplate.Identity) -o %(RecursiveDir)Generated\%(TextTemplate.Filename).gen.cs" />
        <ItemGroup>
            <Compile Include="@(TextTemplate->'%(RecursiveDir)Generated\%(Filename).gen.cs')" Exclude="@(Compile)" />
        </ItemGroup>
    </Target>
</Project>