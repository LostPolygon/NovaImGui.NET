<#@ output extension=".g.cs" #>
<#@ parameter type="System.String" name="TypeName" #>
<#@ parameter type="System.String" name="TypeNamespace" #>
#nullable enable

namespace <#= TypeNamespace #>;

public unsafe struct <#= TypeName #> : IEquatable<<#= TypeName #>> {
    public IntPtr Handle;

    public <#= TypeName #>(void* existingHandle) => Handle = (IntPtr) existingHandle;

    public <#= TypeName #>(IntPtr existingHandle) => Handle = existingHandle;

    public IntPtr IntPtr => Handle;

    public readonly bool Equals(<#= TypeName #> other) => Handle == other.Handle;

    public override bool Equals(object? obj) => obj is <#= TypeName #> other && Equals(other);

    public override int GetHashCode() => Handle.GetHashCode();

    public override string ToString() => Handle != IntPtr.Zero ? Handle.ToString("x8") : "null";

    public static bool operator ==(<#= TypeName #> left, <#= TypeName #> right) => left.Equals(right);

    public static bool operator !=(<#= TypeName #> left, <#= TypeName #> right) => !left.Equals(right);

    public static implicit operator IntPtr(<#= TypeName #> handle) => handle.Handle;

    public static implicit operator <#= TypeName #>(IntPtr existingHandle) => new(existingHandle);

    public static implicit operator <#= TypeName #>(void* existingHandle) => new(existingHandle);
}
