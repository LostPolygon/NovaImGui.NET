<#@ import namespace="System.Linq" #>

<# typeName = $"ImFixedArray{tupleSize}"; #>
public record struct <#= typeName #><T> : IList<T> where T : unmanaged, IEquatable<T> {
<#
   for (int index = 1; index <= tupleSize; index++) {
#>
    public T Value<#= index #>;
<#
   }
#>

    public T this[int index] {
        get {
            if ((uint) index >= <#= tupleSize - 1 #>)
                throw new ArgumentOutOfRangeException(nameof(index), "<#= typeName #> index must be between 0 and <#= tupleSize - 1 #>.");
            
            return Unsafe.Add(ref Value1, index);
        }
        set {
            if ((uint) index >= <#= tupleSize - 1 #>)
                throw new ArgumentOutOfRangeException(nameof(index), "<#= typeName #> index must be between 0 and <#= tupleSize - 1 #>.");
            
            Unsafe.Add(ref Value1, index) = value;
        }
    }

    public <#= typeName #>(<#= String.Join(", ", Enumerable.Range(1, tupleSize).Select(index => $"T value{index}")) #>) {
<#
   for (int index = 1; index <= tupleSize; index++) {
#>
        Value<#= index #> = value<#= index #>;
<#
   }
#>
    }

    public unsafe Span<T> AsSpan() {
        fixed (T* ptr = &Value1) {
            return new Span<T>(ptr, <#= tupleSize #>);
        }
    }

    #region IEnumerable<T>

    public IEnumerator<T> GetEnumerator() {
<#
   // Hardly anyone will use this, so it's fine
   for (int index = 1; index <= tupleSize; index++) {
#>
        yield return Value<#= index #>;
<#
   }
#>
    }

    IEnumerator IEnumerable.GetEnumerator() {
        return GetEnumerator();
    }

    #endregion

    #region IList<T>

    public int IndexOf(T item) {
        return AsSpan().IndexOf(item);
    }

    public void Insert(int index, T item) {
        throw new NotSupportedException();
    }

    public void RemoveAt(int index) {
        throw new NotSupportedException();
    }
    
    public void Add(T item) {
        throw new NotSupportedException();
    }

    public void Clear() {
        throw new NotSupportedException();
    }

    public bool Contains(T item) {
        return AsSpan().Contains(item);
    }

    public void CopyTo(T[] array, int arrayIndex) {
        AsSpan().CopyTo(new Span<T>(array, arrayIndex, array.Length - arrayIndex));
    }

    public bool Remove(T item) {
        throw new NotSupportedException();
    }

    public int Count => <#= tupleSize #>;

    public bool IsReadOnly => false;

    #endregion

<#
   if (tupleSize <= 16) {
#>
    public void Deconstruct(<#= String.Join(", ", Enumerable.Range(1, tupleSize).Select(index => $"out T value{index}")) #>) {
<#
       for (int index = 1; index <= tupleSize; index++) {
#>
        value<#= index #> = Value<#= index #>;
<#
       }
#>
    }

    public static implicit operator <#= typeName #><T>((<#= String.Join(", ", Enumerable.Range(1, tupleSize).Select(index => $"T value{index}")) #>) tuple) => 
        new <#= typeName #><T>(<#= String.Join(", ", Enumerable.Range(1, tupleSize).Select(index => $"tuple.value{index}")) #>);

<#
   }
#>
    public static implicit operator Span<T>(<#= typeName #><T> array) => array.AsSpan();
}
