<#@ template language="C#" #>
<#@ output extension=".g.cs" #>
<#@ include file="TemplateUtility.ttinclude" #><# #>
<#
#nullable enable
    (string Type, string? Conditional)[] Arg1Types = GenericString;
    (string Type, string? Conditional)[] Arg3Types = GenericString;
#>
#nullable enable

namespace NovaImGuiNet;

public static unsafe partial class ImGui {
<#
    foreach (var arg1 in Arg1Types) {
        foreach (var arg3 in Arg3Types) {
            StartConditional(arg1.Conditional, arg3.Conditional);
#>
    public static bool Combo<TEnum>(<#= arg1.Type #> label, ref TEnum currentItem, <#= arg3.Type #> itemsSeparatedByZeros, int popupMaxHeightInItems = -1)
    {
        Type underlyingType = Enum.GetUnderlyingType(typeof(TEnum));
<#
            foreach (var type in new[] { ("int", "Int"), ("uint", "Uint") }) {
#>
        if (underlyingType == typeof(<#= type.Item1 #>)) {
            ref <#= type.Item1 #> currentItem<#= type.Item2 #> = ref Unsafe.As<TEnum, <#= type.Item1 #>>(ref currentItem);
            return Combo(label, ref currentItem<#= type.Item2 #>, itemsSeparatedByZeros, popupMaxHeightInItems);
        }

<#
            }
#>
        throw new InvalidCastException(
            "Only enums with int and uint underlying types are supported, got type: " + underlyingType
        );
    }

<#
            EndConditional(arg1.Conditional, arg3.Conditional);
        }
    }
#>
}
