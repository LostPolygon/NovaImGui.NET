<#@ template language="C#" #>
<#@ output extension=".g.cs" #>
<#@ include file="TemplateUtility.ttinclude" #><# #>
<#
    (string Type, string? Conditional)[] Arg1Types = GenericString;
#>
#nullable enable

namespace NovaImGuiNet;

public static unsafe partial class ImGui {
<#
    foreach (var arg1 in Arg1Types) {
        StartConditional(arg1.Conditional);
#>
    ///<summary>return true when activated.</summary>
    public static bool MenuItem(<#= arg1.Type #> label, bool selected, bool enabled = true)
        => MenuItem(label, (byte*) default, selected, enabled);
        
    ///<summary>return true when activated.</summary>
    public static bool MenuItem(<#= arg1.Type #> label, ref bool selected, bool enabled = true)
        => MenuItem(label, (byte*) default, ref selected, enabled);

<#
        EndConditional(arg1.Conditional);
    }
#>
}
