<#@ template language="C#" #>
<#@ output extension=".g.cs" #>
<#@ include file="TemplateUtility.ttinclude" #><# #>
<#
    StringArgumentDefinition[] Arg1Types = GenericString;
    StringArgumentDefinition[] Arg2Types = GenericString;
#>
#nullable enable

namespace NovaImGuiNet;

using static UnsafeUtility;

public static unsafe partial class ImGui {
<#
    foreach (var arg1 in Arg1Types) {
        foreach (var arg2 in Arg2Types) {
            StartConditional(arg1.Conditional, arg2.Conditional);
#>
    public static bool InputScalar<T>(
        <#= arg1.Type #> label,
        ref T data,
        in T step,
        in T stepFast,
        <#= arg2.Type #> format<#= arg2.Type == "ReadOnlySpan<byte>" ? " = default" : "" #>,
        ImGuiInputTextFlags flags = ImGuiInputTextFlags.None
    ) where T : unmanaged {
        fixed (T* dataPtr = &data)
            return InputScalar(label<#= arg1.InvokeSuffix #>, GetImGuiDataType<T>(), (IntPtr) dataPtr, (IntPtr) AsPointer(in step), (IntPtr) AsPointer(in stepFast), format<#= arg2.InvokeSuffix #>, flags);
    }

    public static bool InputScalarN<T>(
        <#= arg1.Type #> label,
        Span<T> data,
        in T step,
        in T stepFast,
        <#= arg2.Type #> format<#= arg2.Type == "ReadOnlySpan<byte>" ? " = default" : "" #>,
        ImGuiInputTextFlags flags = ImGuiInputTextFlags.None
    ) where T : unmanaged {
        fixed (T* dataPtr = data)
            return InputScalarN(label<#= arg1.InvokeSuffix #>, GetImGuiDataType<T>(), (IntPtr) dataPtr, data.Length, (IntPtr) AsPointer(in step), (IntPtr) AsPointer(in stepFast), format<#= arg2.InvokeSuffix #>, flags);
    }

    public static bool InputScalar<T>(
        <#= arg1.Type #> label,
        ref T data,
        T* step,
        T* stepFast,
        <#= arg2.Type #> format<#= arg2.Type == "ReadOnlySpan<byte>" ? " = default" : "" #>,
        ImGuiInputTextFlags flags = ImGuiInputTextFlags.None
    ) where T : unmanaged {
        fixed (T* dataPtr = &data)
            return InputScalar(label<#= arg1.InvokeSuffix #>, GetImGuiDataType<T>(), (IntPtr) dataPtr, (IntPtr) (&step), (IntPtr) (&stepFast), format<#= arg2.InvokeSuffix #>, flags);
    }

    public static bool InputScalarN<T>(
        <#= arg1.Type #> label,
        Span<T> data,
        T* step,
        T* stepFast,
        <#= arg2.Type #> format<#= arg2.Type == "ReadOnlySpan<byte>" ? " = default" : "" #>,
        ImGuiInputTextFlags flags = ImGuiInputTextFlags.None
    ) where T : unmanaged {
        fixed (T* dataPtr = data)
            return InputScalarN(label<#= arg1.InvokeSuffix #>, GetImGuiDataType<T>(), (IntPtr) dataPtr, data.Length, (IntPtr) (&step), (IntPtr) (&stepFast), format<#= arg2.InvokeSuffix #>, flags);
    }

<#
            EndConditional(arg1.Conditional, arg2.Conditional);
#>
<#
        }
#>
    /*public static bool InputScalar<T>(
        <#= arg1.Type #> label,
        ref T data,
        in T step = default,
        in T stepFast = default
    ) where T : unmanaged {
        fixed (T* dataPtr = &data)
            return InputScalar(label<#= arg1.InvokeSuffix #>, GetImGuiDataType<T>(), (IntPtr) dataPtr, (IntPtr) AsPointer(in step), (IntPtr) AsPointer(in stepFast));
    }

    public static bool InputScalarN<T>(
        <#= arg1.Type #> label,
        Span<T> data,
        in T step = default,
        in T stepFast = default
    ) where T : unmanaged {
        fixed (T* dataPtr = data)
            return InputScalarN(label<#= arg1.InvokeSuffix #>, GetImGuiDataType<T>(), (IntPtr) dataPtr, data.Length, (IntPtr) AsPointer(in step), (IntPtr) AsPointer(in stepFast));
    }*/

<#
    }
#>
}
