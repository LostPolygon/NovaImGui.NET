<#@ import namespace="System.Linq" #>
<#+
#nullable enable
    public class StringArgumentDefinition(string type, string? conditional = null, string invokeSuffix = "") {
        public string Type { get; } = type;
        public string? Conditional { get; } = conditional;
        public string InvokeSuffix { get; } = invokeSuffix;
    }

    StringArgumentDefinition[] GenericString = [
        new("byte*"),
        new("ReadOnlySpan<byte>"),
        new("ReadOnlySpan<char>"),
        new("string", invokeSuffix: ".AsSpan()"),
        new("in ImGuiUtf8StringWriter"),
    ];

    void StartConditional(params string?[] conditionals) {
        string[] validConditionals = conditionals.Where(x => x != null).Distinct().ToArray();
        if (validConditionals.Length == 0)
            return;

        if (validConditionals.Length == 1) {
            WriteLine($"#if {validConditionals[0]}");
        } else {
            WriteLine($"#if {String.Join(" && ", validConditionals.Select(c => $"({c})"))}");
        }
    }

    void EndConditional(params string?[] conditionals) {
        string[] validConditionals = conditionals.Where(x => x != null).ToArray();
        if (validConditionals.Length == 0)
            return;

        WriteLine("#endif");
    }
#>