        ("NovaImGuiNet.Internal", "ImGuiSettingsHandler"),
        ("NovaImGuiNet.Internal", "ImGuiContextHook"),
        ]) {
#>
namespace <#= ns #> {
    public partial struct <#= structName #> {
        public Pointer<T> GetUserData<T>() where T : unmanaged => new Pointer<T>(UserData);
    }
}

<#
    }
#>