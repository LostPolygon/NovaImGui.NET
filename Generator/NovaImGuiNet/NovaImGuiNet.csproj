<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>IMGUI_HAS_DOCK; IMGUI_BACKEND_HAS_WINDOWS_H; NOVA_IMGUI_NET_MAIN; USE_UTF8_STRING_WRITER</DefineConstants>
        <LangVersion>12</LangVersion>
        <NoWarn>$(NoWarn);CS1587;CS1591</NoWarn>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\NovaImGuiNet.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\NovaImGuiNet.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="..\NovaImGuiNet.Shared\SharedAssemblyInfo.cs">
        <Link>SharedAssemblyInfo.cs</Link>
      </Compile>
      <Compile Include="..\NovaImGuiNet.Shared\SharedGlobalUsings.cs">
        <Link>SharedGlobalUsings.cs</Link>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Polyfill" Version="7.4.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Utf8StringInterpolation" Version="1.3.1" />
      <ProjectReference Include="..\NovaImGuiNet.Shared\NovaImGuiNet.Shared.csproj" />
      <PackageReference Update="Nerdbank.GitVersioning">
        <Version>3.6.146</Version>
      </PackageReference>
    </ItemGroup>

    <!-- T4 templates generation -->
    <ItemGroup>
        <TextTemplate Include="**\*.tt"/>
        <Generated Include="**\*.g.cs"/>
    </ItemGroup>

    <Target Name="TextTemplateTransform"
            BeforeTargets="BeforeBuild"
            Inputs="@(TextTemplate)"
            Outputs="@(TextTemplate->'%(RecursiveDir)%(Filename).g.cs')">
        <Exec
                WorkingDirectory="$(ProjectDir)"
                Command="dotnet t4 %(TextTemplate.Identity) -o %(RecursiveDir)%(TextTemplate.Filename).cs"
        />

        <!-- https://github.com/dotnet/msbuild/issues/5570 -->
        <ItemGroup>
            <Compile Include="@(TextTemplate->'%(RecursiveDir)%(Filename).g.cs')" Exclude="@(Compile)"/>
        </ItemGroup>
    </Target>

</Project>
