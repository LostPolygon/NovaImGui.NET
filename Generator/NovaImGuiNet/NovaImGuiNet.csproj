<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>IMGUI_HAS_DOCK; IMGUI_BACKEND_HAS_WINDOWS_H; NOVA_IMGUI_NET_MAIN; USE_UTF8_STRING_WRITER</DefineConstants>
        <LangVersion>12</LangVersion>
        <NoWarn>$(NoWarn);CS1587;CS1591</NoWarn>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\NovaImGuiNet.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\NovaImGuiNet.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="..\NovaImGuiNet.Shared\SharedAssemblyInfo.cs">
        <Link>SharedAssemblyInfo.cs</Link>
      </Compile>
      <Compile Include="..\NovaImGuiNet.Shared\SharedGlobalUsings.cs">
        <Link>SharedGlobalUsings.cs</Link>
      </Compile>
      <Compile Update="Manual\ImGui\ImGui.Begin.g.cs">
        <DependentUpon>ImGui.Begin.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGui\ImGui.ColorPicker3.g.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImGui.ColorPicker3.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGui\ImGui.ColorPicker4.g.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImGui.ColorPicker4.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGuiTypes\UserDataPointerHelpers.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>UserDataPointerHelpers.g.cs</LastGenOutput>
      </Compile>
      <Compile Update="Manual\ImGuiTypes\UserDataPointerHelpers.g.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>UserDataPointerHelpers.tt</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Polyfill" Version="6.8.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Utf8StringInterpolation" Version="1.3.1" />
      <ProjectReference Include="..\NovaImGuiNet.Shared\NovaImGuiNet.Shared.csproj" />
    </ItemGroup>

    <!-- T4 templates generation -->
    <ItemGroup>
        <TextTemplate Include="**\*.tt"/>
        <Generated Include="**\*.g.cs"/>
        <TextTemplate Update="Manual\ImGui\ImGui.ColorEdit.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.CheckboxFlags.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.DragScalar.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.CheckboxFlags.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.RadioButton.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.CheckboxFlags.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.DragDrop.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.CheckboxFlags.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.InputScalar.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.CheckboxFlags.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.VSliderScalar.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.InputScalar.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.MenuItem.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.DragDrop.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.SliderScalar.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.VSliderScalar.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.Begin.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.DragDrop.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.Combo.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.ColorPicker.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.CheckboxFlags.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.ColorPicker3.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.ColorPicker3.g.cs</LastGenOutput>
        </TextTemplate>
        <TextTemplate Update="Manual\ImGui\ImGui.ColorPicker4.tt">
          <Generator>TextTemplatingFileGenerator</Generator>
          <LastGenOutput>ImGui.ColorPicker3.g.cs</LastGenOutput>
        </TextTemplate>
    </ItemGroup>

    <Target Name="TextTemplateTransform"
            BeforeTargets="BeforeBuild"
            Inputs="@(TextTemplate)"
            Outputs="@(TextTemplate->'%(RecursiveDir)%(Filename).g.cs')">
        <Exec
                WorkingDirectory="$(ProjectDir)"
                Command="dotnet t4 %(TextTemplate.Identity) -o %(RecursiveDir)%(TextTemplate.Filename).cs"
        />

        <!-- https://github.com/dotnet/msbuild/issues/5570 -->
        <ItemGroup>
            <Compile Include="@(TextTemplate->'%(RecursiveDir)%(Filename).g.cs')" Exclude="@(Compile)"/>
        </ItemGroup>
    </Target>

</Project>
