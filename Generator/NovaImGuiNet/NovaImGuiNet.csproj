<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>IMGUI_HAS_DOCK; IMGUI_BACKEND_HAS_WINDOWS_H; NOVA_IMGUI_NET_MAIN</DefineConstants>
        <LangVersion>12</LangVersion>
        <TargetFramework>netstandard2.0</TargetFramework>
        <NoWarn>$(NoWarn);CS1587;CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\NovaImGuiNet.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\NovaImGuiNet.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="..\NovaImGuiNet.Shared\SharedAssemblyInfo.cs">
        <Link>SharedAssemblyInfo.cs</Link>
      </Compile>
      <Compile Include="..\NovaImGuiNet.Shared\SharedGlobalUsings.cs">
        <Link>SharedGlobalUsings.cs</Link>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NovaImGuiNet.Shared\NovaImGuiNet.Shared.csproj" />
    </ItemGroup>

</Project>
