<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <DefineConstants>IMGUI_DISABLE_OBSOLETE_FUNCTIONS; IMGUI_HAS_DOCK; IMGUI_BACKEND_HAS_WINDOWS_H; NOVA_IMGUI_NET_MAIN</DefineConstants>
        
        <LangVersion>12</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Polyfill" Version="6.4.1">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="System.Memory" Version="4.5.5" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Manual\ImGuiTypes\ImFixedArray.ttinclude">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>test.cs</LastGenOutput>
      </None>
      <None Update="Manual\ImGuiTypes\ImFixedArray2.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>ImFixedArray2.cs</LastGenOutput>
      </None>
      <None Update="Manual\ImGuiTypes\ImFixedArray3.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>ImFixedArray3.cs</LastGenOutput>
      </None>
      <None Update="Manual\ImGuiTypes\ImFixedArray256.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>ImFixedArray256.cs</LastGenOutput>
      </None>
      <None Update="Manual\ImGuiTypes\ImFixedArray4.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>ImFixedArray4.cs</LastGenOutput>
      </None>
      <None Update="Manual\ImGuiTypes\ImFixedArray5.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>ImFixedArray5.cs</LastGenOutput>
      </None>
      <None Update="Manual\ImGuiTypes\ImFixedArray20.tt">
        <Generator>TextTemplatingFileGenerator</Generator>
        <LastGenOutput>ImFixedArray20.cs</LastGenOutput>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Manual\ImGuiTypes\ImFixedArray2.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImFixedArray2.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGuiTypes\ImFixedArray3.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImFixedArray3.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGuiTypes\ImFixedArray256.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImFixedArray256.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGuiTypes\ImFixedArray4.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImFixedArray4.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGuiTypes\ImFixedArray5.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImFixedArray5.tt</DependentUpon>
      </Compile>
      <Compile Update="Manual\ImGuiTypes\ImFixedArray20.cs">
        <AutoGen>True</AutoGen>
        <DesignTime>True</DesignTime>
        <DependentUpon>ImFixedArray20.tt</DependentUpon>
      </Compile>
      <Compile Include="..\NovaImGuiNet.Shared\SharedAssemblyInfo.cs">
        <Link>SharedAssemblyInfo.cs</Link>
      </Compile>
      <Compile Include="..\NovaImGuiNet.Shared\SharedGlobalUsings.cs">
